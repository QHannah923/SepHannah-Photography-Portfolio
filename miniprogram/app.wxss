page{background:#f8f7f3;color:#292e27;font-family:Arial,sans-serif;font-size:30rpx;line-height:1.65}view,text,input,textarea,button{box-sizing:border-box}.page{padding:42rpx 36rpx 64rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#6c7367;margin-bottom:18rpx}.title{font-family:Georgia,serif;font-size:66rpx;line-height:1.12;margin-bottom:26rpx}.heading{font-size:40rpx;margin:40rpx 0 24rpx;font-weight:500}.muted{color:#6b7267;font-size:26rpx}.brand{font:76rpx Georgia,serif;letter-spacing:-3rpx}.hero{width:100%;height:780rpx;margin:34rpx 0 20rpx}.intro{padding:34rpx 0;border-bottom:1rpx solid #d8dcd3}.chips{display:flex;flex-wrap:wrap;gap:14rpx;margin:26rpx 0}.chip{font-size:26rpx;padding:14rpx 22rpx;border:1rpx solid #cbd1c4;background:transparent;margin:0;line-height:1.5;border-radius:0}.chip::after,button::after{border:0}.chip.active{background:#3b4832;color:white}.button{background:#3b4832;color:white;border:0;border-radius:0;font-size:28rpx;line-height:1.5;padding:26rpx;margin:28rpx 0 0;text-align:left}.button[disabled]{background:#7b8673;color:white}.card{border:1rpx solid #d0d6c8;padding:30rpx;margin:24rpx 0}.card-title{font-size:36rpx;margin-bottom:14rpx}.price{font:50rpx Georgia,serif;margin:20rpx 0}.gallery{display:flex;flex-wrap:wrap;gap:18rpx}.photo{width:calc(50% - 9rpx);height:420rpx}.gallery image{width:100%;height:100%}.notice{padding:26rpx;background:#e9ede2;margin:24rpx 0}.error{color:#7c2e22;background:#fff0e9}.label{font-size:28rpx;margin:30rpx 0 12rpx}input,textarea,.picker{width:100%;border:1rpx solid #bdc6b4;padding:22rpx;background:white;min-height:86rpx;font-size:30rpx}textarea{height:230rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.small-link{display:inline-block;padding:22rpx 0;font-size:27rpx;text-decoration:underline}.slot{display:block;padding:22rpx;border-bottom:1rpx solid #cdd4c6}.step{padding:24rpx 0;border-top:1rpx solid #d7dbd1}.token{word-break:break-all;font-size:24rpx;user-select:text}.space{margin-top:35rpx}
